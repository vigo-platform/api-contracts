{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotificationRequested v2 (PROPOSED)",
  "description": "Ordinary, non-secret notifications only. PROPOSED topic: notification.commands.v2. OTP remains exclusively on v1. Authorization and template catalog checks are mandatory beyond schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "correlation_id", "data"],
  "properties": {
    "event_id": {"$ref": "#/$defs/uuid"},
    "event_type": {"const": "NotificationRequested"},
    "event_version": {"type": "integer", "const": 2},
    "occurred_at": {"$ref": "#/$defs/utcTimestamp"},
    "producer": {
      "type": "string", "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-service$(?![\\s\\S])",
      "description": "Claimed service identity; must match an authenticated, authorized publisher. Syntax is not authorization."
    },
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "template_id", "template_parameters", "deliveries"],
      "properties": {
        "locale": {"enum": ["fa", "en"]},
        "template_id": {
          "type": "string", "maxLength": 128,
          "pattern": "^notification\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]*$(?![\\s\\S])",
          "description": "Immutable catalog ID for ordinary notifications, shared by selected channels. Registered, authorized templates only; never OTP."
        },
        "template_parameters": {
          "type": "object", "maxProperties": 16,
          "propertyNames": {
            "type": "string", "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])",
            "not": {"enum": ["password", "plaintext_password", "token", "access_token", "refresh_token", "credential", "credentials", "secret", "api_key", "otp", "otp_code"]}
          },
          "additionalProperties": {
            "type": "string", "minLength": 1, "maxLength": 256,
            "pattern": "^[^<>\\u0000-\\u001F\\u007F]*$(?![\\s\\S])"
          },
          "description": "Bounded plain-text values. Catalog must separately allowlist keys, types and non-sensitive values. This syntax filter cannot detect secrets or replace contextual output escaping."
        },
        "expires_at": {"$ref": "#/$defs/utcTimestamp"},
        "deliveries": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"$ref": "#/$defs/delivery"},
          "allOf": [
            {"contains": {"properties": {"channel": {"const": "EMAIL"}}, "required": ["channel"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"channel": {"const": "IN_APP"}}, "required": ["channel"]}, "minContains": 0, "maxContains": 1}
          ]
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "utcTimestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?([Zz]|\\+00:00)$(?![\\s\\S])"
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "recipient"],
          "properties": {
            "channel": {"const": "EMAIL"},
            "recipient": {
              "type": "object", "additionalProperties": false, "required": ["destination"],
              "properties": {
                "destination": {
                  "type": "string", "format": "email", "maxLength": 254,
                  "pattern": "^(?=.{1,64}@)[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$(?![\\s\\S])"
                }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "recipient"],
          "properties": {
            "channel": {"const": "IN_APP"},
            "recipient": {
              "type": "object", "additionalProperties": false, "required": ["user_id"],
              "properties": {
                "user_id": {
                  "type": "string", "maxLength": 19,
                  "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
                  "description": "Team-confirmed User internal ID, matching authenticated JWT sub: canonical ASCII decimal string in 1..9223372036854775807, without leading zeroes. Not a public UUID or coach application ID. The pattern bounds strings to positive signed int64; runtime must still enforce user existence and recipient authorization."
                }
              }
            }
          }
        }
      ]
    }
  }
}
